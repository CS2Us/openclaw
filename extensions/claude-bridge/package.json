{
  "name": "@openclaw/claude-bridge",
  "version": "0.1.0",
  "description": "Bridge OpenClaw chat /claude commands to local Claude Code headless.",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "staticAssets": [
        {
          "source": "scripts/perm-hook.cjs",
          "output": "scripts/perm-hook.cjs"
        }
      ]
    }
  }
}
